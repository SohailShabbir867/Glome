NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database
MONGO_URI=mongodb://127.0.0.1:27017/glome

# JWT (use long random strings, minimum 32 characters)
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Email (Nodemailer - Gmail SMTP with Google App Password for OTP / emails)
# Set your Gmail address in SMTP_USER and a 16-character Google App Password in SMTP_PASS
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Glome <no-reply@glome.local>"

# Image uploads (Cloudinary) - optional until the upload module is built
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Payments (Stripe) - optional until the payment module is built
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
